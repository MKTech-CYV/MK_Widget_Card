{
  "expo": {
    "name": "MK Widget Card",
    "slug": "MK_Widget_Card",
    "scheme": "mkwidgetcard",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "buildNumber": "10",
      "bundleIdentifier": "com.mktech.widgetcard",
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép MK Widget Card truy cập camera để quét mã QR danh thiếp.",
        "NSPhotoLibraryUsageDescription": "Cho phép MK Widget Card chọn ảnh để đọc eCard hoặc cập nhật ảnh đại diện.",
        "NSContactsUsageDescription": "Cho phép MK Widget Card lưu eCard đã quét vào danh bạ của bạn."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép MK Widget Card truy cập camera để quét mã QR danh thiếp.",
          "recordAudioAndroid": false
        }
      ],
      "expo-apple-authentication",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7281955271433795~9392965747",
          "iosAppId": "ca-app-pub-7281955271433795~7762039163"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "android": {
      "package": "com.mktech.widgetcard",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fb9ff7c0-83bf-4f70-9970-5ef3bdff5300"
      }
    },
    "owner": "mktechvn",
    "runtimeVersion": "3.1.0",
    "updates": {
      "url": "https://u.expo.dev/fb9ff7c0-83bf-4f70-9970-5ef3bdff5300"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-7281955271433795~9392965747",
    "ios_app_id": "ca-app-pub-7281955271433795~7762039163"
  }
}

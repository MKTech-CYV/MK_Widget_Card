rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Set through Firebase Auth custom claims (website route /api/admin/claims).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function aboutIsValid() {
      return !('about' in request.resource.data)
        || (request.resource.data.about is string && request.resource.data.about.size() <= 600);
    }

    // Doc id == uid. Owner reads/writes their own profile; admins can read.
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // Presets: the owner can read/write them, but cannot re-assign a preset to
    // another user (user_id is immutable) or tamper with share_code, which only
    // the website backend sets (short links are validated server-side).
    match /user_ecards/{docId} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && !('share_code' in request.resource.data)
        && aboutIsValid();
      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.get('share_code', null) == resource.data.get('share_code', null)
        && aboutIsValid();
    }

    match /user_bank_qrs/{docId} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
    }

    // Public in-app announcements: guests read active ones. Only admins
    // (website /admin) can author them.
    match /notifications/{docId} {
      allow read: if resource.data.get('is_active', false) == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Written exclusively by the website backend (Admin SDK bypasses rules).
    // Owners can read their own; admins can read everything.
    match /devices/{docId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /login_events/{docId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /admin_users/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Latest published app versions (app_config/app_version): readable by every
    // install so it can prompt for an update; only admins change it.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Short share links are resolved server-side only.
    match /share_links/{code} {
      allow read, write: if false;
    }
  }
}

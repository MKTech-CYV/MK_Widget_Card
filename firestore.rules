rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Doc id == uid. Only the owner can read/write their own profile.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /user_ecards/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /user_bank_qrs/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Public in-app announcements. Readable without sign-in (guest mode
    // needs them too). No client writes — authored by hand via the
    // Firebase Console for now, which uses privileged access that bypasses
    // these rules entirely.
    match /notifications/{docId} {
      allow read: if resource.data.is_active == true;
      allow write: if false;
    }
  }
}
